---
import { getCollection, render } from "astro:content";
import profile from "../content/profile.json";
import Site from "../layouts/Site.astro";

const projects = await getCollection("projects");
projects.sort((left, right) => left.data.title.localeCompare(right.data.title));
---

<Site title={profile.name} description={profile.bio}>
  <header id="about">
    <h1>{profile.name}</h1>
    <p>{profile.bio}</p>
    {profile.links.length > 0 && (
      <ul class="profile-links" aria-label="Profile links">
        {profile.links.map(({ label, url }) => <li><a href={url}>{label}</a></li>)}
      </ul>
    )}
  </header>

  <section id="projects" aria-labelledby="projects-title">
    <h2 id="projects-title">Projects</h2>
    {projects.map(async (project) => {
      const { Content } = await render(project);
      const { title, url } = project.data;
      return (
        <article>
          <h3>{url ? <a href={url}>{title}</a> : title}</h3>
          <Content />
        </article>
      );
    })}
  </section>
</Site>
