from fastapi import APIRouter

from {{python_package_import_name}}.app.controllers import {% if include_health_endpoints %}health_check, {% endif %}{% if fastapi_enabled and rag_enabled %}rag, {% endif %}{% if include_health_endpoints %}ready{% endif %}
from {{python_package_import_name}}.config import Config


def _get_root_api_router() -> APIRouter:
    """Build root API router with prefix from config.

    Controllers are included here so the prefix is applied once.
    """
    config = Config()
    prefix = config.fastapi_config.api_prefix
    router = APIRouter(prefix=prefix)
{% if include_health_endpoints %}
    router.include_router(ready.router, tags=["ready"])
    router.include_router(health_check.router, tags=["health check"])
{% endif %}
{% if fastapi_enabled and rag_enabled %}
    router.include_router(rag.router)
{% endif %}
    return router


# Module-level router built with default config (for app assembly)
root_api_router = _get_root_api_router()

