"""RAG API routes: query, ingest, health."""

from typing import Any

from fastapi import APIRouter, Depends, HTTPException, Request

from {{python_package_import_name}}.rag import RAGService
from {{python_package_import_name}}.rag.core.types import IngestResult, QueryFilters, RAGAnswer


def get_rag_service(request: Request) -> RAGService:
    """Dependency: get RAGService from app.state."""
    service = getattr(request.app.state, "rag_service", None)
    if service is None:
        raise RuntimeError("RAG service not configured")
    return service


router = APIRouter(prefix="/rag", tags=["rag"])


@router.get("/health", response_model=dict[str, bool])
async def rag_health(service: RAGService = Depends(get_rag_service)) -> dict[str, bool]:  # noqa: B008
    """Return which RAG providers are configured and ready."""
    return service.health()


class QueryResponse(RAGAnswer):
    """Response for POST /rag/query."""


@router.post("/query", response_model=QueryResponse)
async def rag_query(
    body: dict[str, Any],
    service: RAGService = Depends(get_rag_service),  # noqa: B008
) -> QueryResponse:
    """Run RAG query: retrieve + generate answer with citations."""
    query = body.get("query", "")
    top_k = body.get("top_k", 5)
    corpus_id = body.get("corpus_id")
    filters = QueryFilters(corpus_id=corpus_id, metadata=body.get("metadata"))
    answer = service.query(text=query, filters=filters, top_k=top_k)
    return QueryResponse(text=answer.text, citations=answer.citations, query=answer.query)


@router.post("/ingest", response_model=IngestResult)
async def rag_ingest(
    request: Request,
    body: dict[str, Any],
    service: RAGService = Depends(get_rag_service),  # noqa: B008
) -> IngestResult:
    """Ingest a document from a provided source path (optional; can be disabled in prod)."""
    config = getattr(request.app.state, "config", None)
    if config is not None and hasattr(config, "rag_config") and not config.rag_config.ingest_enabled:
        raise HTTPException(status_code=403, detail="RAG ingest is disabled")
    path = body.get("path", "")
    corpus_id = body.get("corpus_id", "default")
    if not path:
        raise HTTPException(status_code=400, detail="path required")
    return service.ingest(path=path, corpus_id=corpus_id)
