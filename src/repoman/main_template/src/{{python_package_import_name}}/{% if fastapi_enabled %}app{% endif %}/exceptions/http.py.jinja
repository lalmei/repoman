"""Application implementation - custom FastAPI HTTP exception with handler."""

from typing import Any

from fastapi import Request
from fastapi.responses import JSONResponse


class HTTPException(Exception):  # noqa: N818
    """Custom HTTPException class.

    This exception combined with exception_handler allows you to use it
    the same way as FastAPI.HTTPException, with freedom to define the
    returned response body (FastAPI.HTTPException returns content under "detail").

    FastAPI.HTTPException source:
    https://github.com/tiangolo/fastapi/blob/master/fastapi/exceptions.py
    """

    def __init__(
        self,
        status_code: int,
        content: Any = None,
        headers: dict[str, Any] | None = None,
    ) -> None:
        """Initialize HTTPException.

        Args:
            status_code: HTTP error status code.
            content: Response body.
            headers: Additional response headers.
        """
        self.status_code = status_code
        self.content = content
        self.headers = headers

    def __repr__(self) -> str:
        """Return string representation."""
        kwargs = [f"{k}={v!r}" for k, v in self.__dict__.items() if not k.startswith("_")]
        return f"{self.__class__.__name__}({', '.join(kwargs)})"


async def http_exception_handler(_request: Request, exception: Exception) -> JSONResponse:
    """Custom HTTPException handler.

    Registered in asgi.py when initializing the FastAPI application.
    https://fastapi.tiangolo.com/tutorial/handling-errors/#install-custom-exception-handlers

    Args:
        request: Request instance.
        exception: Custom HTTPException instance.

    Returns:
        JSONResponse with status_code, content, and headers from the exception.
    """
    if not isinstance(exception, HTTPException):
        raise exception
    return JSONResponse(
        status_code=exception.status_code,
        content=exception.content,
        headers=exception.headers,
    )
