{% if dataset_enabled %}"""Dataset configuration for PyTorch data loading.

This class uses pydantic-settings to define and load dataset-specific
environment variables. Supports loading from .env files and config/dataset_config.json.
"""

from pathlib import Path
from typing import Literal

from pydantic import Field
from pydantic_settings import (
    BaseSettings,
    JsonConfigSettingsSource,
    PydanticBaseSettingsSource,
    SettingsConfigDict,
)


class DatasetConfig(BaseSettings):
    """Dataset configuration: paths, splits, DataLoader params.

    This class uses pydantic and pydantic-settings to define and load dataset-specific
    environment variables. It supports loading from .env and .env.prod files
    (lowest to highest priority), and from config/dataset_config.json.
    """

    model_config = SettingsConfigDict(
        env_prefix="DATASET_",
        env_file=(".env", ".env.dev", ".env.prod"),
        env_file_encoding="utf-8",
        json_file="config/dataset_config.json",
        extra="ignore",
    )

    modality: Literal[
{%- if dataset_modality_image -%}
        "image"{%- if dataset_modality_text or dataset_modality_tabular or dataset_modality_mesh or dataset_modality_rag_eval -%},{%- endif -%}
{%- endif -%}
{%- if dataset_modality_text -%}
        "text"{%- if dataset_modality_tabular or dataset_modality_mesh or dataset_modality_rag_eval -%},{%- endif -%}
{%- endif -%}
{%- if dataset_modality_tabular -%}
        "tabular"{%- if dataset_modality_mesh or dataset_modality_rag_eval -%},{%- endif -%}
{%- endif -%}
{%- if dataset_modality_mesh -%}
        "mesh"{%- if dataset_modality_rag_eval -%},{%- endif -%}
{%- endif -%}
{%- if dataset_modality_rag_eval -%}
        "rag_eval"
{%- endif -%}
    ] = Field(
        default={% if dataset_modality_image %}"image"{% elif dataset_modality_text %}"text"{% elif dataset_modality_tabular %}"tabular"{% elif dataset_modality_mesh %}"mesh"{% else %}"rag_eval"{% endif %},
        description="Dataset modality for this project.",
    )
    data_root: Path = Field(default=Path("."), description="Root directory for datasets.")
    train_split: float = Field(default=0.8, description="Train fraction (rest = val).")
    val_split: float = Field(default=0.2, description="Validation fraction.")
    seed: int = Field(default=42, description="Random seed for splits.")
    batch_size: int = Field(default=32, description="Default batch size.")
    num_workers: int = Field(default=0, description="DataLoader workers.")
    pin_memory: bool = Field(default=True, description="PyTorch pin_memory.")
{% if dataset_modality_image %}
    image_size: tuple[int, int] = Field(
        default=(224, 224),
        description="Default image size for vision.",
    )
{% endif %}
{% if dataset_modality_text %}
    # Text modality
    text_column: str = Field(default="text", description="Column name for text content.")
    label_column: str | None = Field(default="label", description="Column name for labels (optional).")
    text_format: Literal["jsonl", "csv"] = Field(default="jsonl", description="Format for text data.")
{% endif %}
{% if dataset_modality_tabular %}
    # Tabular modality
    target_column: str = Field(default="target", description="Column name for target variable.")
    tabular_format: Literal["csv", "parquet"] = Field(
        default="csv",
        description="Format for tabular data.",
    )
    delimiter: str = Field(default=",", description="CSV delimiter.")
{% endif %}
{% if dataset_modality_rag_eval %}
    # RAG eval modality
    query_column: str = Field(default="query", description="Column name for queries.")
    reference_column: str = Field(default="reference", description="Column name for ground-truth answers.")
    contexts_column: str | None = Field(
        default="contexts",
        description="Column name for ground-truth contexts (optional).",
    )
{% endif %}
{% if dataset_modality_mesh %}
    # Mesh modality (class folders of OBJ files; template ships OBJ loader)
    mesh_extensions: list[str] = Field(
        default_factory=lambda: [".obj"],
        description="File suffixes for mesh files in each class directory.",
    )
{% endif %}

    @classmethod
    def settings_customise_sources(
        cls,
        settings_cls: type[BaseSettings],
        init_settings: PydanticBaseSettingsSource,
        env_settings: PydanticBaseSettingsSource,
        dotenv_settings: PydanticBaseSettingsSource,
        file_secret_settings: PydanticBaseSettingsSource,
    ) -> tuple[PydanticBaseSettingsSource, ...]:
        """Customise settings sources to support JSON file loading."""
        return (
            init_settings,
            JsonConfigSettingsSource(settings_cls),
            env_settings,
            dotenv_settings,
            file_secret_settings,
        )
{% else %}
"""Dataset configuration (disabled). Enable dataset in copier answers to use this module."""
{% endif %}
