{% if rag_enabled %}"""RAG application configuration.

This class uses pydantic-settings to define and load RAG-specific
environment variables. Supports loading from .env files and rag_config.json.
"""

from pathlib import Path
from typing import Literal

from pydantic import Field, model_validator
from pydantic_settings import (
    BaseSettings,
    JsonConfigSettingsSource,
    PydanticBaseSettingsSource,
    SettingsConfigDict,
)


class RAGConfig(BaseSettings):
    """RAG configuration: providers, paths, model names.

    This class uses pydantic and pydantic-settings to define and load RAG-specific
    environment variables. It supports loading from .env and .env.prod files
    (lowest to highest priority), and from rag_config.json.
    """

    model_config = SettingsConfigDict(
        env_prefix="RAG_",
        env_file=(".env", ".env.dev", ".env.prod"),
        env_file_encoding="utf-8",
        json_file="rag_config.json",
        extra="ignore",
    )

    config_path: Path | None = Field(
        default=None,
        description="Optional path to an external config file (env and rag_config.json are primary).",
    )
    vector_store: str = Field(default="faiss", description="Vector store adapter (currently: faiss).")
    embedder_provider: Literal["sentence_transformers", "modernbert"] = Field(
        default="sentence_transformers",
        description="Embedder provider: sentence_transformers or modernbert.",
    )
    docstore_path: str = Field(default=":memory:", description="Docstore path; :memory: or file path for SQLite.")
    embedder_model: str = Field(
        default="all-MiniLM-L6-v2",
        description="Embedding model name. For modernbert provider, use a ModernBERT model id.",
    )
    reranker_model: str = Field(
        default="cross-encoder/ms-marco-MiniLM-L-6-v2",
        description="Cross-encoder model for reranking.",
    )
    llm_provider: str = Field(default="stub", description="LLM provider: stub or future adapters.")
    chunk_size: int = Field(default=512, description="Default chunk size in characters.")
    chunk_overlap: int = Field(default=64, description="Overlap between chunks.")
    ingest_enabled: bool = Field(
        default=True,
        description="Whether POST /rag/ingest is enabled (can disable in prod).",
    )

    @classmethod
    def settings_customise_sources(
        cls,
        settings_cls: type[BaseSettings],
        init_settings: PydanticBaseSettingsSource,
        env_settings: PydanticBaseSettingsSource,
        dotenv_settings: PydanticBaseSettingsSource,
        file_secret_settings: PydanticBaseSettingsSource,
    ) -> tuple[PydanticBaseSettingsSource, ...]:
        """Customise settings sources to support JSON file loading."""
        return (
            init_settings,
            JsonConfigSettingsSource(settings_cls),
            env_settings,
            dotenv_settings,
            file_secret_settings,
        )

    @model_validator(mode="after")
    def validate_embedder_provider_and_model(self) -> "RAGConfig":
        """Validate embedder provider/model compatibility."""
        model_name = self.embedder_model.strip()
        if not model_name:
            raise ValueError("embedder_model must be a non-empty string")

        lower_model_name = model_name.lower()
        if self.embedder_provider == "modernbert" and "modernbert" not in lower_model_name:
            raise ValueError(
                "embedder_model must reference a ModernBERT model when embedder_provider='modernbert'",
            )
        if self.embedder_provider == "sentence_transformers" and "modernbert" in lower_model_name:
            raise ValueError(
                "embedder_model appears to be ModernBERT; set embedder_provider='modernbert'",
            )
        return self
