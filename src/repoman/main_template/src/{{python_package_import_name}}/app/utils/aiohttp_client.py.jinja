{% if fastapi_enabled %}"""Aiohttp client class utility."""

import asyncio
import logging
from socket import AF_INET
from typing import TYPE_CHECKING, Any

import aiohttp

from {{python_package_import_name}}.config import Config

if TYPE_CHECKING:
    from {{python_package_import_name}}.config.fastapi_config import FastAPIConfig


class AiohttpClient:
    """Aiohttp session client utility.

    Utility class for handling HTTP async requests for the FastAPI application.
    Timeout and pool size are read from FastAPIConfig when provided.

    Attributes:
        sem: Optional semaphore.
        aiohttp_client: Aiohttp client session instance.
    """

    sem: asyncio.Semaphore | None = None
    aiohttp_client: aiohttp.ClientSession | None = None
    log: logging.Logger = logging.getLogger(__name__)

    @classmethod
    def get_aiohttp_client(
        cls,
        fastapi_config: "FastAPIConfig | None" = None,
    ) -> aiohttp.ClientSession:
        """Create or return existing aiohttp client session.

        Args:
            fastapi_config: Optional FastAPI config for timeout and pool size.
                If None, Config().fastapi_config is used.

        Returns:
            aiohttp.ClientSession instance.
        """
        if cls.aiohttp_client is None:
            if fastapi_config is None:
                fastapi_config = Config().fastapi_config
            timeout_sec = fastapi_config.aiohttp_timeout
            pool_size = fastapi_config.aiohttp_pool_size
            cls.log.debug("Initialize AiohttpClient session.")
            timeout = aiohttp.ClientTimeout(total=timeout_sec)
            connector = aiohttp.TCPConnector(
                family=AF_INET,
                limit_per_host=pool_size,
            )
            cls.aiohttp_client = aiohttp.ClientSession(
                timeout=timeout,
                connector=connector,
            )
        return cls.aiohttp_client

    @classmethod
    async def close_aiohttp_client(cls) -> None:
        """Close aiohttp client session."""
        if cls.aiohttp_client:
            cls.log.debug("Close AiohttpClient session.")
            await cls.aiohttp_client.close()
            cls.aiohttp_client = None

    @classmethod
    async def get(
        cls,
        url: str,
        *,
        headers: dict[str, str] | None = None,
        raise_for_status: bool = False,
    ) -> aiohttp.ClientResponse:
        """Execute HTTP GET request."""
        client = cls.get_aiohttp_client()
        cls.log.debug("Started GET %s", url)
        return await client.get(
            url,
            headers=headers,
            raise_for_status=raise_for_status,
        )

    @classmethod
    async def post(
        cls,
        url: str,
        *,
        data: Any | None = None,
        headers: dict[str, str] | None = None,
        raise_for_status: bool = False,
    ) -> aiohttp.ClientResponse:
        """Execute HTTP POST request."""
        client = cls.get_aiohttp_client()
        cls.log.debug("Started POST %s", url)
        return await client.post(
            url,
            data=data,
            headers=headers,
            raise_for_status=raise_for_status,
        )

    @classmethod
    async def put(
        cls,
        url: str,
        *,
        data: Any | None = None,
        headers: dict[str, str] | None = None,
        raise_for_status: bool = False,
    ) -> aiohttp.ClientResponse:
        """Execute HTTP PUT request."""
        client = cls.get_aiohttp_client()
        cls.log.debug("Started PUT %s", url)
        return await client.put(
            url,
            data=data,
            headers=headers,
            raise_for_status=raise_for_status,
        )

    @classmethod
    async def delete(
        cls,
        url: str,
        *,
        headers: dict[str, str] | None = None,
        raise_for_status: bool = False,
    ) -> aiohttp.ClientResponse:
        """Execute HTTP DELETE request."""
        client = cls.get_aiohttp_client()
        cls.log.debug("Started DELETE %s", url)
        return await client.delete(
            url,
            headers=headers,
            raise_for_status=raise_for_status,
        )

    @classmethod
    async def patch(
        cls,
        url: str,
        *,
        data: Any | None = None,
        headers: dict[str, str] | None = None,
        raise_for_status: bool = False,
    ) -> aiohttp.ClientResponse:
        """Execute HTTP PATCH request."""
        client = cls.get_aiohttp_client()
        cls.log.debug("Started PATCH %s", url)
        return await client.patch(
            url,
            data=data,
            headers=headers,
            raise_for_status=raise_for_status,
        )
