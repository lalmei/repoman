"""Top-level RAG pipeline: retrieve + generate -> RAGAnswer with citations."""

from typing import Callable

from {{python_package_import_name}}.rag.core.pipeline.generate import run_generate
from {{python_package_import_name}}.rag.core.pipeline.retrieve import run_retrieve
from {{python_package_import_name}}.rag.core.ports import (
    DocstorePort,
    EmbedderPort,
    LLMPort,
    RerankerPort,
    VectorIndexPort,
)
from {{python_package_import_name}}.rag.core.types import QueryFilters, RAGAnswer


def run_rag(
    query: str,
    embedder: EmbedderPort,
    vector_index: VectorIndexPort,
    docstore: DocstorePort,
    llm: LLMPort,
    build_prompt: Callable[[str, str], str],
    top_k: int = 5,
    filters: QueryFilters | None = None,
    reranker: RerankerPort | None = None,
    rerank_top_k: int | None = None,
) -> RAGAnswer:
    """Run full RAG: retrieve context then generate answer with citations.

    Args:
        query: User query.
        embedder: Embedder implementation.
        vector_index: Vector index implementation.
        docstore: Docstore implementation.
        llm: LLM implementation.
        build_prompt: Callable(query, context_text) -> prompt.
        top_k: Retrieval top_k.
        filters: Optional query filters.
        reranker: Optional reranker.
        rerank_top_k: Top k after rerank.

    Returns:
        RAGAnswer with text and citations.
    """
    chunks = run_retrieve(
        query=query,
        embedder=embedder,
        vector_index=vector_index,
        docstore=docstore,
        top_k=top_k,
        filters=filters,
        reranker=reranker,
        rerank_top_k=rerank_top_k,
    )
    return run_generate(
        query=query,
        context_chunks=chunks,
        llm=llm,
        build_prompt=build_prompt,
    )
