{% if rag_enabled %}"""Generate pipeline: build prompt from context, call LLM, return answer."""

from collections.abc import Callable

from {{python_package_import_name}}.rag.core.ports import LLMPort
from {{python_package_import_name}}.rag.core.types import Citation, RAGAnswer, RetrievedChunk


def run_generate(
    query: str,
    context_chunks: list[RetrievedChunk],
    llm: LLMPort,
    build_prompt: Callable[[str, str], str],
) -> RAGAnswer:
    """Build prompt from query + context, call LLM, parse answer with citations.

    Args:
        query: User query.
        context_chunks: Retrieved chunks for context.
        llm: LLM implementation.
        build_prompt: Callable(query, context_text) -> prompt string.

    Returns:
        RAGAnswer with text and citations.
    """
    context_text = "\n\n".join(c.text for c in context_chunks)
    prompt = build_prompt(query, context_text)
    answer_text = llm.generate(prompt)
    citations = [
        Citation(chunk_id=c.id, text=c.text[:200], score=c.score, corpus_id=c.corpus_id)
        for c in context_chunks
    ]
    return RAGAnswer(text=answer_text, citations=citations, query=query)
{% endif %}
