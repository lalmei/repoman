"""ModernBERT embedder adapter based on Hugging Face transformers."""

from types import SimpleNamespace
from typing import Any

import numpy as np

from {{python_package_import_name}}.rag.core.ports import EmbedderPort


class ModernBERTEmbedder(EmbedderPort):
    """Embedder using a ModernBERT model via transformers + torch."""

    def __init__(self, model_name: str = "answerdotai/ModernBERT-base") -> None:
        """Load tokenizer and model for embeddings.

        Args:
            model_name: Hugging Face model id for ModernBERT.
        """
        try:
            from transformers import AutoModel, AutoTokenizer  # noqa: PLC0415
        except ImportError as e:
            raise ImportError(
                "transformers is required for ModernBERTEmbedder. "
                "Install with: uv sync --group rag-modernbert",
            ) from e

        self._tokenizer = AutoTokenizer.from_pretrained(model_name)
        self._model = AutoModel.from_pretrained(model_name)
        self._model.eval()
        self._model_name = model_name
        config = getattr(self._model, "config", SimpleNamespace(hidden_size=None))
        self._hidden_size = getattr(config, "hidden_size", None)

    @property
    def dimension(self) -> int:
        """Return embedding dimension inferred from the model config."""
        if self._hidden_size is None:
            raise RuntimeError("ModernBERT model must expose config.hidden_size")
        return int(self._hidden_size)

    def _as_numpy(self, value: object) -> np.ndarray:
        tensor: Any = value
        if hasattr(tensor, "detach"):
            tensor = tensor.detach()
        if hasattr(tensor, "cpu"):
            tensor = tensor.cpu()
        if hasattr(tensor, "numpy"):
            tensor = tensor.numpy()
        return np.asarray(tensor, dtype=np.float32)

    def _encode(self, texts: list[str]) -> list[list[float]]:
        if not texts:
            return []

        encoded = self._tokenizer(texts, padding=True, truncation=True, return_tensors="pt")
        outputs = self._model(**encoded)
        hidden = self._as_numpy(outputs.last_hidden_state)  # [batch, seq, dim]
        attention = self._as_numpy(encoded["attention_mask"])[..., None]  # [batch, seq, 1]

        masked = hidden * attention
        token_counts = attention.sum(axis=1)
        token_counts[token_counts == 0] = 1.0
        pooled = masked.sum(axis=1) / token_counts

        norms = np.linalg.norm(pooled, axis=1, keepdims=True)
        norms[norms == 0] = 1.0
        normalized = pooled / norms
        return normalized.astype(np.float32).tolist()

    def embed(self, text: str) -> list[float]:
        """Embed a single text."""
        vectors = self._encode([text])
        return vectors[0] if vectors else []

    def embed_batch(self, texts: list[str]) -> list[list[float]]:
        """Embed multiple texts."""
        return self._encode(texts)
