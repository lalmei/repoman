"""FAISS vector index adapter."""

from pathlib import Path
from typing import Any

import numpy as np

from {{python_package_import_name}}.rag.core.ports import VectorIndexPort


class FAISSVectorIndex(VectorIndexPort):
    """FAISS-backed vector index (optional dependency: faiss-cpu)."""

    def __init__(self, index_path: Path | str | None = None) -> None:
        """Build in-memory index; optionally load/save from path.

        Args:
            index_path: Optional path to load/save FAISS index.
        """
        try:
            import faiss  # noqa: PLC0415
        except ImportError as e:
            raise ImportError(
                "faiss-cpu is required for FAISSVectorIndex. Install with: uv sync --group rag"
            ) from e
        self._faiss = faiss
        self._index_path = Path(index_path) if index_path else None
        self._index: faiss.IndexFlatL2 | None = None
        self._id_to_row: list[str] = []
        self._dim: int | None = None

    def _ensure_index(self, dim: int) -> None:
        if self._index is None:
            self._index = self._faiss.IndexFlatL2(dim)
            self._dim = dim
        elif self._dim != dim:
            raise ValueError(f"Dimension mismatch: index has {self._dim}, got {dim}")

    def add(self, chunk_ids: list[str], vectors: list[list[float]], corpus_id: str) -> None:  # noqa: ARG002
        """Add vectors to FAISS index."""
        if not vectors:
            return
        dim = len(vectors[0])
        self._ensure_index(dim)
        if self._index is None:
            raise RuntimeError("FAISS index not initialized")
        matrix = np.array(vectors, dtype=np.float32)
        self._index.add(matrix)
        self._id_to_row.extend(chunk_ids)

    def search(
        self,
        query_vector: list[float],
        top_k: int,
        corpus_id: str | None = None,  # noqa: ARG002
        metadata_filter: dict[str, Any] | None = None,  # noqa: ARG002
    ) -> list[tuple[str, float]]:
        """Search FAISS index. corpus_id and metadata_filter ignored (single index)."""
        if self._index is None or not self._id_to_row:
            return []
        matrix = np.array([query_vector], dtype=np.float32)
        scores, indices = self._index.search(matrix, min(top_k, len(self._id_to_row)))
        out: list[tuple[str, float]] = []
        for idx, dist in zip(indices[0], scores[0]):
            if idx < 0:
                break
            if idx < len(self._id_to_row):
                # FAISS returns L2 distance (lower better); return -distance so higher is better
                out.append((self._id_to_row[idx], -float(dist)))
        return out
