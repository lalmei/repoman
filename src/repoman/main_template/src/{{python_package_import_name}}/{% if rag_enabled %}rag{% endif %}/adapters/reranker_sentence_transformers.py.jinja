"""Sentence-transformers cross-encoder reranker adapter."""

from {{python_package_import_name}}.rag.core.ports import RerankerPort
from {{python_package_import_name}}.rag.core.types import RetrievedChunk


class SentenceTransformersReranker(RerankerPort):
    """Reranker using sentence-transformers cross-encoder (optional dependency)."""

    def __init__(self, model_name: str = "cross-encoder/ms-marco-MiniLM-L-6-v2") -> None:
        """Load cross-encoder model.

        Args:
            model_name: Model name for CrossEncoder.
        """
        try:
            from sentence_transformers import CrossEncoder
        except ImportError as e:
            raise ImportError(
                "sentence-transformers is required for SentenceTransformersReranker. "
                "Install with: uv sync --group rag"
            ) from e
        self._model = CrossEncoder(model_name)

    def rerank(self, query: str, candidates: list[RetrievedChunk], top_k: int) -> list[RetrievedChunk]:
        """Rerank candidates by relevance to query."""
        if not candidates:
            return []
        pairs = [(query, c.text) for c in candidates]
        scores = self._model.predict(pairs)
        scored = list(zip(candidates, scores.tolist()))
        scored.sort(key=lambda x: x[1], reverse=True)
        return [
            RetrievedChunk(
                id=c.id,
                text=c.text,
                corpus_id=c.corpus_id,
                score=score,
                metadata=c.metadata,
            )
            for c, score in scored[:top_k]
        ]
