from typing import TYPE_CHECKING

from {{python_package_import_name}}.datasets.types import RAGEvalItem

if TYPE_CHECKING:
    from {{python_package_import_name}}.rag.service import RAGService


def _answer_overlap_score(pred: str, ref: str) -> float:
    """Simple overlap: fraction of ref words present in pred (case-insensitive)."""
    if not ref.strip():
        return 1.0 if pred.strip() else 0.0
    ref_words = set(ref.lower().split())
    pred_words = set(pred.lower().split())
    if not ref_words:
        return 1.0
    return len(ref_words & pred_words) / len(ref_words)


def _retrieval_recall(
    retrieved_texts: list[str],
    ground_truth_contexts: list[str],
) -> float:
    """Recall: fraction of gt contexts with overlap in retrieved chunks."""
    if not ground_truth_contexts:
        return 0.0
    hits = 0
    for ctx in ground_truth_contexts:
        ctx_lower = ctx.lower()
        ctx_words = set(ctx_lower.split())
        for chunk in retrieved_texts:
            chunk_words = set(chunk.lower().split())
            if ctx_words & chunk_words:
                hits += 1
                break
    return hits / len(ground_truth_contexts)


def run_rag_eval(
    rag_service: "RAGService",
    eval_dataset: list[RAGEvalItem],
) -> dict[str, float]:
    """Run RAG evaluation over an evaluation dataset.

    For each item: runs rag_service.query, compares response with reference.
    Returns answer_match (mean overlap) and retrieval_recall (if contexts provided).

    Args:
        rag_service: RAGService instance (from container).
        eval_dataset: List of RAGEvalItem from load_rag_eval_dataset.

    Returns:
        Dict with "answer_match" (float) and optionally "retrieval_recall" (float).
    """
    answer_scores: list[float] = []
    recall_scores: list[float] = []
    has_contexts = any(item.contexts for item in eval_dataset)

    for item in eval_dataset:
        answer = rag_service.query(item.query)
        pred_text = answer.text
        answer_scores.append(_answer_overlap_score(pred_text, item.reference))

        if item.contexts and has_contexts:
            retrieved_texts = [c.text for c in answer.citations]
            recall_scores.append(_retrieval_recall(retrieved_texts, item.contexts))

    result: dict[str, float] = {
        "answer_match": sum(answer_scores) / len(answer_scores) if answer_scores else 0.0,
    }
    if recall_scores:
        result["retrieval_recall"] = sum(recall_scores) / len(recall_scores)

    return result
