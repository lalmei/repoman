{% if rag_enabled %}"""RAG infrastructure configuration (YAML + env)."""

from pathlib import Path
from typing import Any

import yaml
from pydantic import Field
from pydantic_settings import BaseSettings, SettingsConfigDict


def _load_yaml_if_exists(path: Path) -> dict[str, Any]:
    """Load YAML file into dict if it exists; otherwise return empty dict."""
    if path.exists():
        with open(path, encoding="utf-8") as f:
            return yaml.safe_load(f) or {}
    return {}


class RAGConfig(BaseSettings):
    """RAG configuration: providers, paths, model names.

    Loads from RAG_CONFIG_PATH (YAML) and env vars (env overrides).
    """

    model_config = SettingsConfigDict(
        env_prefix="RAG_",
        env_file=(".env", ".env.dev", ".env.prod"),
        env_file_encoding="utf-8",
        extra="ignore",
    )

    config_path: Path | None = Field(
        default=None,
        description="Path to RAG YAML config file (e.g. config/rag.yml).",
    )
    vector_store: str = Field(default="faiss", description="Vector store: faiss or qdrant.")
    docstore_path: str = Field(default=":memory:", description="Docstore path; :memory: or file path for SQLite.")
    embedder_model: str = Field(
        default="all-MiniLM-L6-v2",
        description="Sentence-transformers model for embeddings.",
    )
    reranker_model: str = Field(
        default="cross-encoder/ms-marco-MiniLM-L-6-v2",
        description="Cross-encoder model for reranking.",
    )
    llm_provider: str = Field(default="stub", description="LLM provider: stub or future adapters.")
    chunk_size: int = Field(default=512, description="Default chunk size in characters.")
    chunk_overlap: int = Field(default=64, description="Overlap between chunks.")
    ingest_enabled: bool = Field(
        default=True,
        description="Whether POST /rag/ingest is enabled (can disable in prod).",
    )

    @classmethod
    def from_yaml_path(cls, path: Path | None) -> "RAGConfig":
        """Build config from YAML file and env. Env overrides YAML."""
        yaml_data: dict[str, Any] = _load_yaml_if_exists(path) if path else {}
        base = cls()
        merged = {**yaml_data, **base.model_dump()}
        return cls.model_validate(merged)

{% endif %}
