"""Prompt builder: build prompt string from template name + variables."""

from pathlib import Path

from jinja2 import Environment, FileSystemLoader, select_autoescape


def get_templates_dir() -> Path:
    """Return directory containing RAG prompt templates."""
    return Path(__file__).resolve().parent / "templates"


def build_prompt(template_name: str, **variables: str) -> str:
    """Build prompt from a template file.

    Args:
        template_name: Template file name (e.g. rag_answer.txt).
        **variables: Variables to render (e.g. query, context).

    Returns:
        Rendered prompt string.
    """
    templates_dir = get_templates_dir()
    env = Environment(
        loader=FileSystemLoader(str(templates_dir)),
        autoescape=select_autoescape(enabled_extensions=()),
    )
    template = env.get_template(template_name)
    return template.render(**variables)


def build_rag_answer_prompt(query: str, context: str) -> str:
    """Build the RAG answer prompt (query + context).

    Args:
        query: User query.
        context: Retrieved context text.

    Returns:
        Full prompt string.
    """
    return build_prompt("rag_answer.txt", query=query, context=context)
