{% if dataset_enabled and dataset_modality_text %}"""Text dataset for JSONL/CSV with configurable columns."""

import json
import random
from pathlib import Path

import pandas as pd
import torch
from torch.utils.data import DataLoader, Dataset, Subset

from {{python_package_import_name}}.config.dataset_config import DatasetConfig


def _collate_text_batch(
    batch: list[tuple[str, int]],
) -> tuple[list[str], torch.Tensor]:
    """Collate texts and labels into lists and tensor."""
    texts = [item[0] for item in batch]
    labels = torch.tensor([item[1] for item in batch], dtype=torch.long)
    return texts, labels


class TextDataset(Dataset):
    """PyTorch Dataset for text from JSONL or CSV with optional labels."""

    def __init__(
        self,
        path: str | Path,
        config: DatasetConfig,
    ) -> None:
        """Load text data from JSONL or CSV.

        Args:
            path: Path to JSONL or CSV file.
            config: DatasetConfig with text_column, label_column, text_format.
        """
        self.config = config
        path = Path(path)
        if not path.exists():
            msg = f"Text data file does not exist: {path}"
            raise FileNotFoundError(msg)

        if config.text_format == "jsonl":
            self._rows = self._load_jsonl(path)
        else:
            self._rows = self._load_csv(path)

        self._text_col = config.text_column
        self._label_col = config.label_column

    def _load_jsonl(self, path: Path) -> list[dict]:
        """Load JSONL file."""
        rows = []
        with open(path, encoding="utf-8") as f:
            for raw_line in f:
                stripped = raw_line.strip()
                if stripped:
                    rows.append(json.loads(stripped))
        return rows

    def _load_csv(self, path: Path) -> list[dict]:
        """Load CSV file."""
        df = pd.read_csv(path, sep=self.config.delimiter)
        return df.to_dict(orient="records")

    def __len__(self) -> int:
        """Return number of rows."""
        return len(self._rows)

    def __getitem__(self, idx: int) -> tuple[str, int]:
        """Return (text, label). Label is -1 if missing."""
        row = self._rows[idx]
        text = str(row.get(self._text_col, ""))
        if self._label_col and self._label_col in row:
            try:
                label = int(row[self._label_col])
            except (ValueError, TypeError):
                label = -1
        else:
            label = -1
        return text, label


def get_text_loaders(
    config: DatasetConfig,
    data_root: str | Path | None = None,
    batch_size: int | None = None,
) -> tuple[DataLoader, DataLoader]:
    """Create train and validation DataLoaders for text data.

    Expects a single file at data_root (or data_root/text.jsonl / text.csv).
    If data_root is a file path, uses it directly. If a directory, looks for
    a file matching the format (e.g. *.jsonl or *.csv).

    Args:
        config: DatasetConfig with paths, splits, and column names.
        data_root: Override config.data_root if provided. Can be file or dir.
        batch_size: Override config.batch_size if provided.

    Returns:
        (train_loader, val_loader) tuple.
    """
    root = Path(data_root) if data_root is not None else config.data_root
    bs = batch_size if batch_size is not None else config.batch_size

    if root.is_file():
        path = root
    else:
        if not root.exists():
            msg = f"Data root does not exist: {root}"
            raise FileNotFoundError(msg)
        ext = ".jsonl" if config.text_format == "jsonl" else ".csv"
        candidates = list(root.glob(f"*{ext}"))
        if not candidates:
            msg = f"No {ext} file found in {root}"
            raise FileNotFoundError(msg)
        path = candidates[0]

    dataset = TextDataset(path=path, config=config)

    n = len(dataset)
    indices = list(range(n))
    rng = random.Random(config.seed)  # noqa: S311 - deterministic shuffle
    rng.shuffle(indices)

    split_idx = int(n * config.train_split)
    train_indices = indices[:split_idx]
    val_indices = indices[split_idx:]

    train_loader = DataLoader(
        Subset(dataset, train_indices),
        batch_size=bs,
        shuffle=True,
        num_workers=config.num_workers,
        pin_memory=config.pin_memory,
        collate_fn=_collate_text_batch,
    )
    val_loader = DataLoader(
        Subset(dataset, val_indices),
        batch_size=bs,
        shuffle=False,
        num_workers=config.num_workers,
        pin_memory=config.pin_memory,
        collate_fn=_collate_text_batch,
    )

    return train_loader, val_loader
