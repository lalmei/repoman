        return _get_image_loaders(config, data_root, batch_size, transform)
{%- endif %}
{%- if dataset_modality_text %}
    if config.modality == "text":
        return _get_text_loaders(config, data_root, batch_size)
{%- endif %}
{%- if dataset_modality_tabular %}
    if config.modality == "tabular":
        return _get_tabular_loaders(config, data_root, batch_size)
{%- endif %}
{%- if dataset_modality_mesh %}
    if config.modality == "mesh":
        return _get_mesh_loaders(config, data_root, batch_size)
{%- endif %}
    msg = f"modality '{config.modality}' has no train/val loaders in this project"
    raise ValueError(msg)
