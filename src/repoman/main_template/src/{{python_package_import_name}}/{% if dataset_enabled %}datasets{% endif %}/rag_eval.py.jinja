{% if dataset_enabled %}"""RAG evaluation dataset loader."""

import json
from pathlib import Path

from {{python_package_import_name}}.config.dataset_config import DatasetConfig
from {{python_package_import_name}}.datasets.types import RAGEvalItem


def load_rag_eval_dataset(
    path: Path | str,
    config: DatasetConfig | None = None,
) -> list[RAGEvalItem]:
    """Load RAG evaluation dataset from JSONL or JSON file.

    Each row must have query and reference. Optional contexts (list of strings).
    Column names are taken from config or default to query, reference, contexts.

    Args:
        path: Path to JSONL (one JSON object per line) or JSON (array of objects).
        config: Optional DatasetConfig for column names. Uses defaults if None.

    Returns:
        List of RAGEvalItem.

    Raises:
        FileNotFoundError: If path does not exist.
        ValueError: If required columns are missing.
    """
    path = Path(path)
    if not path.exists():
        msg = f"RAG eval dataset file does not exist: {path}"
        raise FileNotFoundError(msg)

    q_col = config.query_column if config else "query"
    r_col = config.reference_column if config else "reference"
    c_col = config.contexts_column if config else "contexts"

    rows: list[dict]
    suffix = path.suffix.lower()
    if suffix == ".jsonl":
        rows = []
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line:
                    rows.append(json.loads(line))
    elif suffix == ".json":
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
        if isinstance(data, list):
            rows = data
        else:
            rows = [data]
    else:
        msg = f"Unsupported format: {suffix}. Use .jsonl or .json"
        raise ValueError(msg)

    items: list[RAGEvalItem] = []
    for i, row in enumerate(rows):
        if q_col not in row:
            msg = f"Row {i}: missing required column '{q_col}'"
            raise ValueError(msg)
        if r_col not in row:
            msg = f"Row {i}: missing required column '{r_col}'"
            raise ValueError(msg)

        query = str(row[q_col])
        reference = str(row[r_col])
        contexts = row.get(c_col) if c_col else None
        if contexts is not None and not isinstance(contexts, list):
            contexts = [str(contexts)] if contexts else None
        elif contexts is not None:
            contexts = [str(c) for c in contexts]

        items.append(RAGEvalItem(query=query, reference=reference, contexts=contexts))

    return items
