"""Query subcommand: run RAG query and print answer with citations."""

from rich.console import Console
from rich.panel import Panel
from rich.text import Text
from typer import Argument, Option, Typer

from {{python_package_import_name}}.utils.theme.theme import set_theme

app = Typer(
    add_completion=True,
    invoke_without_command=True,
    no_args_is_help=True,
    help="Run a RAG query and print answer with citations.",
)


@app.callback(invoke_without_command=True)
def query(
    question: str = Argument(..., help="Question to ask"),
    top_k: int = Option(5, "--top-k", "-k", help="Number of chunks to retrieve"),
    theme: str = Option("dark", "--theme", help="Theme: light or dark"),
) -> None:
    """Run a RAG query and print answer with citations."""
    from {{python_package_import_name}}.cli.commands.rag import _get_rag_service  # noqa: PLC0415

    console = Console(theme=set_theme(theme))
    try:
        service = _get_rag_service()
        answer = service.query(text=question, top_k=top_k)
        console.print(
            Panel(
                Text(answer.text, style="green"), title="Answer", border_style="green"
            )
        )
        if answer.citations:
            cite_lines = [
                f"  - [{c.chunk_id}] (score={c.score:.3f}) {c.text[:80]}..."
                for c in answer.citations
            ]
            console.print(
                Panel("\n".join(cite_lines), title="Citations", border_style="blue")
            )
    except Exception as e:
        console.print(
            Panel(Text(str(e), style="red"), title="Error", border_style="red")
        )
        raise SystemExit(1) from e
