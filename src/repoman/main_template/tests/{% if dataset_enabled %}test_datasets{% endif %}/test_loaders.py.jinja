{% endif %}
{% if dataset_modality_mesh %}
def test_get_train_val_loaders_mesh(tmp_path: Path) -> None:
    """get_train_val_loaders with modality=mesh returns mesh loaders."""
    obj = """v 0 0 0
v 1 0 0
v 0 1 0
f 1 2 3
"""
    for name in ("c0", "c1"):
        d = tmp_path / name
        d.mkdir()
        (d / f"{name}.obj").write_text(obj, encoding="utf-8")

    config = DatasetConfig(
        modality="mesh",
        data_root=str(tmp_path),
        mesh_extensions=[".obj"],
        train_split=0.5,
        seed=42,
        batch_size=1,
        num_workers=0,
        pin_memory=False,
    )
    train_loader, val_loader = get_train_val_loaders(config, data_root=tmp_path)
    list(train_loader)
    list(val_loader)

{% endif %}
{% if dataset_modality_image %}
def test_get_train_val_loaders_image(tmp_path: Path) -> None:
    """get_train_val_loaders with modality=image returns image loaders."""
    pytest.importorskip("PIL")
    from PIL import Image

    # Need at least 2 images so train split gets >= 1 sample (train_split=0.8)
    for i, class_name in enumerate(("class0", "class1")):
        class_dir = tmp_path / class_name
        class_dir.mkdir()
        img_path = class_dir / f"img{i}.png"
        Image.new("RGB", (1, 1), color="red").save(img_path)

    config = DatasetConfig(
        modality="image",
        data_root=str(tmp_path),
        train_split=0.8,
        seed=42,
        batch_size=1,
        num_workers=0,
        pin_memory=False,
    )
    train_loader, val_loader = get_train_val_loaders(config, data_root=tmp_path)
    list(train_loader)
    list(val_loader)

{% endif %}
