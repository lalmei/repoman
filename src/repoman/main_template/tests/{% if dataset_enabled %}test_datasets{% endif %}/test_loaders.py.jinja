"""Tests for get_train_val_loaders dispatch."""

from pathlib import Path

import pytest

pytest.importorskip("torch")

from {{ python_package_import_name }}.config.dataset_config import DatasetConfig
from {{ python_package_import_name }}.datasets.loaders import get_train_val_loaders


{% if dataset_modality_tabular %}
def test_get_train_val_loaders_tabular(tmp_path: Path) -> None:
    """get_train_val_loaders with modality=tabular returns tabular loaders."""
    import pandas as pd

    csv_path = tmp_path / "t.csv"
    pd.DataFrame({"f1": [1.0, 2.0], "f2": [0, 1], "target": [0.0, 1.0]}).to_csv(
        csv_path, index=False
    )
    config = DatasetConfig(
        modality="tabular",
        data_root=str(tmp_path),
        tabular_format="csv",
        target_column="target",
        train_split=0.5,
        seed=42,
        num_workers=0,
        pin_memory=False,
    )
    train_loader, val_loader = get_train_val_loaders(config, data_root=csv_path)
    list(train_loader)
    list(val_loader)

{% endif %}
{% if dataset_modality_text %}
def test_get_train_val_loaders_text(tmp_path: Path) -> None:
    """get_train_val_loaders with modality=text returns text loaders."""
    jsonl_path = tmp_path / "text.jsonl"
    jsonl_path.write_text('{"text": "hello", "label": 0}\n{"text": "world", "label": 1}\n')
