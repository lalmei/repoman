def test_rag_config_rejects_provider_model_mismatch() -> None:
    """RAGConfig rejects mismatched provider/model combinations."""
    import pytest
    from pydantic import ValidationError

    from {{ python_package_import_name }}.config.rag_config import RAGConfig

    with pytest.raises(ValidationError):
        RAGConfig(
            embedder_provider="modernbert",
            embedder_model="all-MiniLM-L6-v2",
        )
