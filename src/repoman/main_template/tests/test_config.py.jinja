def test_load_rag_eval_dataset() -> None:
    """Load eval_sample.jsonl and check structure."""
    from pathlib import Path

    import pytest

    from {{ python_package_import_name }}.datasets import RAGEvalItem, load_rag_eval_dataset

    fixtures = Path(__file__).parent / "fixtures"
    path = fixtures / "eval_sample.jsonl"
    if not path.exists():
        pytest.skip("eval_sample.jsonl fixture not found")

    items = load_rag_eval_dataset(path)
    assert len(items) == 2
    assert isinstance(items[0], RAGEvalItem)
    assert items[0].query == "Who introduced relativity?"
    assert items[0].reference == "Albert Einstein."
    assert items[1].query == "First computer programmer?"
    assert items[1].reference == "Ada Lovelace."

