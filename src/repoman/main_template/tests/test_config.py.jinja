def test_get_text_loaders() -> None:
    """Load text_sample.jsonl and get train/val loaders."""
    from pathlib import Path

    import pytest

    pytest.importorskip("torch")

    from {{ python_package_import_name }}.config import DatasetConfig
    from {{ python_package_import_name }}.datasets import get_text_loaders

    fixtures = Path(__file__).parent / "fixtures"
    path = fixtures / "text_sample.jsonl"
    if not path.exists():
        pytest.skip("text_sample.jsonl fixture not found")

    config = DatasetConfig(
        modality="text",
        data_root=str(fixtures),
        text_format="jsonl",
        train_split=0.67,
        batch_size=2,
        pin_memory=False,  # avoid MPS warning in CI (e.g. Apple Silicon)
    )
    train_loader, _ = get_text_loaders(config, data_root=path)
    train_batches = list(train_loader)
    assert len(train_batches) >= 1
    texts, labels = train_batches[0]
    assert len(texts) <= 2
    assert labels.shape[0] <= 2

