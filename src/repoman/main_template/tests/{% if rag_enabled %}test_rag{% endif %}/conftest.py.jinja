class FakeEmbedder(EmbedderPort):
    """In-memory fake embedder (deterministic hashes)."""

    @property
    def dimension(self) -> int:
        return 4

    def embed(self, text: str) -> list[float]:
        h = hash(text) % 1000
        return [float(h % 10), float((h // 10) % 10), float((h // 100) % 10), 0.0]

    def embed_batch(self, texts: list[str]) -> list[list[float]]:
        return [self.embed(t) for t in texts]


class FakeVectorIndex(VectorIndexPort):
    """In-memory fake vector index (brute-force)."""

    def __init__(self) -> None:
        self._ids: list[str] = []
        self._vectors: list[list[float]] = []
        self._corpus: list[str] = []

    def add(self, chunk_ids: list[str], vectors: list[list[float]], corpus_id: str) -> None:
        self._ids.extend(chunk_ids)
        self._vectors.extend(vectors)
        self._corpus.extend([corpus_id] * len(chunk_ids))

    def search(
        self,
        query_vector: list[float],
        top_k: int,
        corpus_id: str | None = None,
        metadata_filter: dict | None = None,
    ) -> list[tuple[str, float]]:
        best: list[tuple[str, float, int]] = []
        for i, (vid, vec, cid) in enumerate(zip(self._ids, self._vectors, self._corpus)):
            if corpus_id is not None and cid != corpus_id:
                continue
            score = -sum((a - b) ** 2 for a, b in zip(query_vector, vec)) ** 0.5
            best.append((vid, score, i))
        best.sort(key=lambda x: x[1], reverse=True)
        return [(vid, s) for vid, s, _ in best[:top_k]]


class FakeDocstore(DocstorePort):
    """In-memory fake docstore."""

    def __init__(self) -> None:
        self._chunks: dict[str, Chunk] = {}

    def put(self, chunks: list[Chunk]) -> None:
        for c in chunks:
            self._chunks[c.id] = c

    def get(self, chunk_id: str) -> Chunk | None:
        return self._chunks.get(chunk_id)

    def get_many(self, chunk_ids: list[str]) -> list[Chunk | None]:
        return [self._chunks.get(cid) for cid in chunk_ids]

    def list_corpus_ids(self) -> list[str]:
        return list({c.corpus_id for c in self._chunks.values()})
