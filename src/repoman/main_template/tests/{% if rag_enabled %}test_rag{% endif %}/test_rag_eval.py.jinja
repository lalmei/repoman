"""Tests for RAG evaluation (rag.eval module and eval CLI)."""

from pathlib import Path
from unittest.mock import MagicMock, patch

import pytest
from typer.testing import CliRunner

from {{ python_package_import_name }}.datasets import RAGEvalItem
from {{ python_package_import_name }}.rag.core.types import Citation, RAGAnswer


def test_answer_overlap_score_full_match() -> None:
    """_answer_overlap_score returns 1.0 when pred contains all ref words."""
    from {{ python_package_import_name }}.rag.eval import _answer_overlap_score

    assert _answer_overlap_score("Albert Einstein proposed relativity", "Albert Einstein") == 1.0


def test_answer_overlap_score_partial() -> None:
    """_answer_overlap_score returns fraction of ref words in pred."""
    from {{ python_package_import_name }}.rag.eval import _answer_overlap_score

    # ref has 3 words: albert einstein proposed; pred has albert einstein (2/3)
    score = _answer_overlap_score("Albert Einstein said so", "Albert Einstein proposed")
    assert 0.5 <= score <= 1.0


def test_answer_overlap_score_empty_ref() -> None:
    """_answer_overlap_score returns 1.0 for empty ref when pred non-empty."""
    from {{ python_package_import_name }}.rag.eval import _answer_overlap_score

    assert _answer_overlap_score("something", "") == 1.0
    assert _answer_overlap_score("", "") == 0.0


def test_retrieval_recall_empty_gt() -> None:
    """_retrieval_recall returns 0.0 when ground_truth_contexts is empty."""
    from {{ python_package_import_name }}.rag.eval import _retrieval_recall

    assert _retrieval_recall(["chunk1"], []) == 0.0


def test_retrieval_recall_full_hit() -> None:
    """_retrieval_recall returns 1.0 when all gt contexts have overlap in retrieved."""
    from {{ python_package_import_name }}.rag.eval import _retrieval_recall

    retrieved = ["Albert Einstein proposed the theory of relativity"]
    gt = ["Albert Einstein", "theory of relativity"]
    assert _retrieval_recall(retrieved, gt) == 1.0


def test_retrieval_recall_partial() -> None:
    """_retrieval_recall returns fraction when only some contexts hit."""
    from {{ python_package_import_name }}.rag.eval import _retrieval_recall

    retrieved = ["Only first context here"]
    gt = ["first context", "missing second"]
    score = _retrieval_recall(retrieved, gt)
    assert 0 < score < 1.0


def test_run_rag_eval_returns_metrics() -> None:
    """run_rag_eval returns dict with answer_match and optionally retrieval_recall."""
    from {{ python_package_import_name }}.rag.eval import run_rag_eval

    fake_service = MagicMock()
    fake_service.query.return_value = RAGAnswer(
        query="q",
        text="Albert Einstein proposed relativity",
        citations=[
            Citation(chunk_id="1", text="Einstein.", score=0.9, corpus_id="default"),
        ],
    )
    dataset = [
        RAGEvalItem(query="Who proposed relativity?", reference="Albert Einstein.", contexts=["Einstein"]),
    ]
    result = run_rag_eval(rag_service=fake_service, eval_dataset=dataset)
    assert "answer_match" in result
    assert 0 <= result["answer_match"] <= 1.0
    assert "retrieval_recall" in result


def test_run_rag_eval_no_contexts() -> None:
    """run_rag_eval with no contexts in items does not include retrieval_recall."""
    from {{ python_package_import_name }}.rag.eval import run_rag_eval

    fake_service = MagicMock()
    fake_service.query.return_value = RAGAnswer(
        query="q", text="Answer", citations=[]
    )
    dataset = [
        RAGEvalItem(query="q?", reference="ref", contexts=None),
    ]
    result = run_rag_eval(rag_service=fake_service, eval_dataset=dataset)
    assert "answer_match" in result
    assert "retrieval_recall" not in result


def test_rag_eval_cli_success(cli_runner: CliRunner) -> None:
    """Eval command prints metrics table when dataset loads."""
    from {{ python_package_import_name }}.cli.commands.rag import app as rag_app

    fixtures = Path(__file__).parent.parent / "fixtures" / "eval_sample.jsonl"
    if not fixtures.exists():
        pytest.skip("eval_sample.jsonl fixture not found")

    with patch(
        "{{ python_package_import_name }}.cli.commands.rag._get_rag_service",
        return_value=MagicMock(
            query=MagicMock(return_value=RAGAnswer(query="", text="Albert Einstein.", citations=[])),
        ),
    ):
        result = cli_runner.invoke(
            rag_app,
            ["eval", "--dataset", str(fixtures)],
            catch_exceptions=False,
        )
    assert result.exit_code == 0
    assert "Metric" in result.output or "answer_match" in result.output


def test_rag_eval_cli_empty_dataset(cli_runner: CliRunner, tmp_path: Path) -> None:
    """Eval command exits 1 when dataset is empty."""
    from {{ python_package_import_name }}.cli.commands.rag import app as rag_app

    empty_jsonl = tmp_path / "empty.jsonl"
    empty_jsonl.write_text("")
    with patch(
        "{{ python_package_import_name }}.cli.commands.rag.eval.load_rag_eval_dataset",
        return_value=[],
    ):
        result = cli_runner.invoke(
            rag_app, ["eval", "--dataset", str(empty_jsonl)], catch_exceptions=False
        )
    assert result.exit_code == 1
    assert "empty" in result.output.lower() or "Error" in result.output


