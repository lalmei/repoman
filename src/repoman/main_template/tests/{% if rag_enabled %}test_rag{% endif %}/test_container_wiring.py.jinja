"""Tests for RAG container wiring decisions."""

from unittest.mock import patch

import pytest

from {{ python_package_import_name }}.rag.infra.config import RAGConfig
from {{ python_package_import_name }}.rag.wiring.container import RAGContainer


def test_container_uses_sentence_transformers_embedder() -> None:
    """Container builds sentence-transformers embedder when provider is configured."""
    cfg = RAGConfig(
        embedder_provider="sentence_transformers",
        embedder_model="all-MiniLM-L6-v2",
    )
    container = RAGContainer(cfg)
    with patch(
        "{{ python_package_import_name }}.rag.wiring.container.SentenceTransformersEmbedder",
    ) as st_embedder:
        _ = container.embedder
        st_embedder.assert_called_once_with(model_name="all-MiniLM-L6-v2")


def test_container_uses_modernbert_embedder() -> None:
    """Container builds ModernBERT embedder when provider is configured."""
    cfg = RAGConfig(
        embedder_provider="modernbert",
        embedder_model="answerdotai/ModernBERT-base",
    )
    container = RAGContainer(cfg)
    with patch(
        "{{ python_package_import_name }}.rag.wiring.container.ModernBERTEmbedder",
    ) as modernbert_embedder:
        _ = container.embedder
        modernbert_embedder.assert_called_once_with(model_name="answerdotai/ModernBERT-base")


def test_container_rejects_unknown_embedder_provider() -> None:
    """Container raises for unsupported provider values."""
    cfg = RAGConfig()
    cfg.embedder_provider = "unsupported"  # type: ignore[assignment]
    container = RAGContainer(cfg)

    with pytest.raises(ValueError, match=r"Unsupported embedder_provider"):
        _ = container.embedder
