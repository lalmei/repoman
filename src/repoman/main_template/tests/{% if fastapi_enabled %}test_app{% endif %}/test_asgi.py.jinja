"""Tests for ASGI application and lifespan."""

from fastapi import FastAPI
from fastapi.testclient import TestClient

from {{ python_package_import_name }}.app.asgi import get_application
from {{ python_package_import_name }}.app.utils import AiohttpClient
from {{ python_package_import_name }}.config import Config, FastAPIConfig


def test_get_application_returns_fastapi_app() -> None:
    """Test that get_application returns a FastAPI instance with metadata."""
    app = get_application()
    assert isinstance(app, FastAPI)
    assert app.title == "{{ python_package_import_name }}"
    assert app.version is not None
    assert app.description is not None


def test_application_startup_and_shutdown() -> None:
    """Start the app with custom settings and verify routes and client cleanup."""
    settings = FastAPIConfig(api_prefix="/custom", docs_url="/custom-docs", aiohttp_timeout=17)
    config = Config(app_name="Custom API", fastapi_config=settings)
    app = get_application(config=config)

    with TestClient(app) as client:
        assert app.state.config is config
        assert client.get("/custom-docs").status_code == 200
        schema = client.get("/openapi.json").json()
        assert schema["info"]["title"] == "Custom API"
{% if include_health_endpoints %}
        assert set(schema["paths"]) == {"/custom/healthcheck", "/custom/ready"}
        assert client.get("/custom/healthcheck").status_code == 200
        assert client.get("/custom/ready").status_code == 200
{% else %}
        assert not schema["paths"]
        assert client.get("/custom/healthcheck").status_code == 404
        assert client.get("/custom/ready").status_code == 404
{% endif %}
        session = AiohttpClient.aiohttp_client
        assert session is not None
        assert session.timeout.total == 17

    assert session.closed
