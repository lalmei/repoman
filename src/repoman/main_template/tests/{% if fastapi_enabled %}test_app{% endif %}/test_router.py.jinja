"""Tests for API router configuration."""

from fastapi import APIRouter
from fastapi.testclient import TestClient

from {{ python_package_import_name }}.app.router import root_api_router, _get_root_api_router


def test_root_api_router_has_prefix() -> None:
    """Test that root_api_router has the configured API prefix."""
    assert isinstance(root_api_router, APIRouter)
    assert root_api_router.prefix == "{{ fastapi_api_prefix }}"


def test_get_root_api_router_returns_router() -> None:
    """Test that _get_root_api_router returns configured APIRouter."""
    router = _get_root_api_router()
    assert isinstance(router, APIRouter)
    assert router.prefix == "{{ fastapi_api_prefix }}"

{% if include_health_endpoints %}
def test_health_routes_registered(client: TestClient) -> None:
    """Test that health check and ready routes are registered."""
    health_response = client.get("/api/healthcheck")
    assert health_response.status_code == 200

    ready_response = client.get("/api/ready")
    assert ready_response.status_code == 200
