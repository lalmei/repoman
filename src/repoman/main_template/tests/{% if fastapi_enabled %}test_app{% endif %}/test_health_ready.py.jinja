"""Tests for health check and ready endpoints."""

{% if include_health_endpoints %}
from fastapi.testclient import TestClient


def test_healthcheck_returns_ok(client: TestClient) -> None:
    """Test that the health endpoint returns 200 with a healthcheck message."""
    response = client.get({{ fastapi_api_prefix | tojson }} + "/healthcheck")
    assert response.status_code == 200
    data = response.json()
    assert data["healthcheck"] == "Everything OK!"


def test_ready_returns_ok(client: TestClient) -> None:
    """Test that the ready endpoint returns 200 with status ok."""
    response = client.get({{ fastapi_api_prefix | tojson }} + "/ready")
    assert response.status_code == 200
    data = response.json()
    assert data["status"] == "ok"
{% else %}
# Health endpoints disabled - no tests
import pytest


def test_placeholder_when_health_disabled() -> None:
    """Placeholder when include_health_endpoints is False."""
    pytest.skip("Health endpoints disabled")
{% endif %}
