"""Tests for health check and ready endpoints."""

{% if include_health_endpoints %}
import pytest
from fastapi.testclient import TestClient


def test_healthcheck_returns_ok(client: TestClient) -> None:
    """Test that GET /api/healthcheck returns 200 with healthcheck message."""
    response = client.get("/api/healthcheck")
    assert response.status_code == 200
    data = response.json()
    assert data["healthcheck"] == "Everything OK!"


def test_ready_returns_ok(client: TestClient) -> None:
    """Test that GET /api/ready returns 200 with status ok."""
    response = client.get("/api/ready")
    assert response.status_code == 200
    data = response.json()
    assert data["status"] == "ok"
{% else %}
