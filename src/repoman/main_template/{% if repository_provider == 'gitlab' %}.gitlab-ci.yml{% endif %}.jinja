workflow:
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_TAG'
    - if: '$CI_COMMIT_BRANCH && $CI_OPEN_MERGE_REQUESTS && $CI_PIPELINE_SOURCE == "push"'
      when: never
    - if: '$CI_COMMIT_BRANCH'

stages:
  - quality
{% if not docs_only %}
  - test
  - package
{% endif %}

variables:
  GIT_DEPTH: "0"
  PYTHON_VERSION: "3.12"
  UV_PYTHON_DOWNLOADS: never

default:
  image: "python:${PYTHON_VERSION}-bookworm"
  before_script:
    - pip install uv==0.13.7

quality:
  stage: quality
  script:
    - make setup
{% if not docs_only %}
    - make check
    - make test-coverage-report
{% endif %}
    - make check-docs
{% if not docs_only %}

tests:
  stage: test
  parallel:
    matrix:
      - PYTHON_VERSION: ["3.11", "3.12", "3.13", "3.14"]
        UV_RESOLUTION: [highest, lowest-direct]
  rules:
    - if: '$PYTHON_VERSION == "3.14"'
      allow_failure: true
    - when: on_success
  script:
    - make setup
    - make test

distributions:
  stage: package
  rules:
    - if: '$CI_COMMIT_TAG'
  script:
    - make build
  artifacts:
    paths:
      - dist/
{% endif %}
