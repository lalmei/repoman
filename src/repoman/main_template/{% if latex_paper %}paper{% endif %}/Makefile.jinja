TECTONIC ?= tectonic
MAIN := main
BUILD_DIR := build
PDF := $(MAIN).pdf

.PHONY: all
all: pdf

.PHONY: pdf
pdf: ## Build $(PDF) with Tectonic.
	mkdir -p $(BUILD_DIR)
	$(TECTONIC) --outdir $(BUILD_DIR) $(MAIN).tex
	cp $(BUILD_DIR)/$(PDF) $(PDF)

.PHONY: watch
watch: pdf ## Rebuild $(PDF) whenever sources change.
	mkdir -p $(BUILD_DIR)
	$(TECTONIC) -X watch -x "compile --outdir $(BUILD_DIR) $(MAIN).tex"

.PHONY: clean
clean: ## Remove LaTeX build artifacts.
	rm -rf $(BUILD_DIR)

.PHONY: distclean
distclean: clean ## Remove generated PDF.
	rm -f $(PDF)
