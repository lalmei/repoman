services:
  app:
    build:
      context: .
      dockerfile: Dockerfile.prod
    environment:
      OPENAI_API_KEY: ${OPENAI_API_KEY:-}
      PYTHONUNBUFFERED: "1"
      RAG_DOCSTORE_PATH: /app/.data/rag.sqlite3
    ports:
      - "8000:8000"
    volumes:
      - ./.data:/app/.data
    restart: unless-stopped
