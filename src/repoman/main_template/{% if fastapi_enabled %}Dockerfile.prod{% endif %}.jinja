FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV UV_LINK_MODE=copy

COPY pyproject.toml README.md ./
COPY src ./src
COPY config ./config

RUN uv sync --no-dev --no-editable --no-default-groups

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "{{python_package_import_name}}.app.asgi:get_application", "--factory", "--host", "0.0.0.0", "--port", "8000"]
