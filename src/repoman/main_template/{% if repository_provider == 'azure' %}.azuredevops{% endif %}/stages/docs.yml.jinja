stages:
  - stage: docs
    displayName: Build documentation
    jobs:
      - job: docs
        displayName: Build docs site
        pool:
          vmImage: ubuntu-22.04
        variables:
          python.version: "3.12"
          UV_CACHE_DIR: $(Pipeline.Workspace)/.uv-cache
        steps:
          - checkout: self
          - task: UsePythonVersion@0
            inputs:
              versionSpec: "$(python.version)"
            displayName: Use Python $(python.version)
          - script: curl -LsSf https://astral.sh/uv/install.sh | sh
            displayName: Install uv
          - task: Cache@2
            inputs:
              key: '"uv" | "$(Agent.OS)" | pyproject.toml | uv.lock'
              restoreKeys: |
                "uv" | "$(Agent.OS)" | pyproject.toml
                "uv" | "$(Agent.OS)"
              path: $(UV_CACHE_DIR)
            displayName: Restore uv cache
          - script: |
              export PATH="$HOME/.local/bin:$PATH"
              uv sync
              make test-ci-coverage
              rm -rf docs/coverage
              cp -R htmlcov docs/coverage
              uv run python scripts/generate_coverage_badge.py coverage.xml docs/coverage-badge.json
              make docs-check
            displayName: Build docs
          - publish: site
            artifact: site
            displayName: Publish docs artifact
