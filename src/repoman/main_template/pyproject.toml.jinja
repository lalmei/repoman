{% set repo_host_by_provider = {"github": "github.com", "gitlab": "gitlab.com", "azure": "azure.com"} -%}
{% set repo_host = repo_host_by_provider[repository_provider] -%}
{% set repo_url = "https://" ~ repo_host ~ "/" ~ repository_namespace ~ "/" ~ repository_name -%}
{% if repository_provider == "github" -%}
{% set docs_url = "https://" ~ repository_namespace ~ ".github.io/" ~ repository_name -%}
{% elif repository_provider == "gitlab" -%}
{% set docs_url = "https://" ~ repository_namespace ~ ".gitlab.io/" ~ repository_name -%}
{% else -%}
{% set docs_url = repo_url -%}
{% endif -%}
[build-system]
requires = ["uv_build>=0.8.13,<0.9.0"]
build-backend = "uv_build"




[project]
name = "{{ python_package_distribution_name }}"
description = "{{ project_description }}"
authors = [{name = "{{ author_fullname }}", email = "{{ author_email }}"}]
license = "{{ copyright_license }}"
license-files = ["LICENSE"]
readme = "README.md"
requires-python = ">=3.11"
keywords = []
version = "0.1.0"
classifiers = [
    "Development Status :: 4 - Beta",
    "Intended Audience :: Developers",
    "Programming Language :: Python",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3 :: Only",
    "Programming Language :: Python :: 3.11",
    "Programming Language :: Python :: 3.12",
    "Programming Language :: Python :: 3.13",
    "Programming Language :: Python :: 3.14",
    "Topic :: Documentation",
    "Topic :: Software Development",
    "Topic :: Utilities",
    "Typing :: Typed",
]
dependencies = [
    "catppuccin>=2.5.0",
    "pydantic-settings>=2.12.0",
    "rich>=14.3.0",
    "pydantic>=2.12.0",
    "typer>=0.17.3",
    {%- if fastapi_enabled %}
    "aiohttp>=3.13.0",
    "fastapi>=0.128.0",
    "uvicorn[standard]>=0.38.0",
    {%- endif %}
]

[project.urls]
Homepage = "{{ docs_url }}"
Documentation = "{{ docs_url }}"
Changelog = "{% if repository_provider in ('github', 'gitlab') %}{{ docs_url }}/changelog{% else %}{{ repo_url }}{% endif %}"
Repository = "{{ repo_url }}"
Issues = "{% if repository_provider == 'github' %}{{ repo_url }}/issues{% elif repository_provider == 'gitlab' %}{{ repo_url }}/-/issues{% else %}{{ repo_url }}{% endif %}"
{% if repository_provider == "github" %}
Discussions = "{{ repo_url }}/discussions"
Funding = "https://{{ repo_host }}/sponsors/{{ author_username }}"
{% endif %}

{% if python_package_command_line_name -%}
[project.scripts]
{{ python_package_command_line_name }} = "{{ python_package_import_name }}.cli:main"

{% endif -%}
{% if not docs_only %}
[tool.uv.build-backend]
module-root = "src"
module-name = "{{python_package_import_name}}"
{% endif %}

[tool.uv]
default-groups = ["maintain", "ci", "docs"{% if rag_enabled %}, "rag"{% endif %}{% if dataset_enabled %}, "dl"{% endif %}]

[dependency-groups]

dev = [
    {%- if python_notebooks %}
    "ipykernel>=6.29.5",
    "nbconvert>=7.0.0",
    "glob2==0.6",
    "ipywidgets>=8.1.5",
    {%- endif %}
]

ml = [
    "mlflow>=3.9.0",
]
{% if dataset_enabled %}
dl = [
    "pandas>=2.0.0",
    "pyarrow>=14.0.0",
    "torch>=2.0.0",
    "torchvision>=0.15.0",
]
{% endif %}
{% if rag_enabled %}
rag = [
    "PyYAML>=6.0",
    "jinja2>=3.1.0",
    "numpy>=1.24.0",
    "sentence-transformers>=2.2.0",
    "faiss-cpu>=1.7.4",
]
rag-modernbert = [
    "torch>=2.0.0",
    "transformers>=4.52.0",
]
eval = [
    "pytest>=9.0.0",
]
{% endif %}
maintain = [
    "bump2version>=1.0.1",
    {%- if python_notebooks %}
    "nb-clean>=4.0.1",
    {%- endif %}
    "monkeytype>=23.3.0",
]
ci = [
    "coverage>=7.13.0",
    "httpx>=0.28.0",
    "interrogate>=1.7.0",
    "mypy>=1.19.0",
    "pytest>=9.0.0",
    "pytest-cov>=7.0.0",
    "pytest-randomly>=4.0.0",
    "pytest-xdist>=3.8.0",
    "ruff>=0.14.0",
    "types-markdown>=3.6",
    "types-pyyaml>=6.0",
]
docs = [
    "markdown-callouts>=0.4.0",
    "markdown-exec>=1.12.0",
    "mkdocs-coverage>=2.0.0",
    "mkdocs-gen-files>=0.6.0",
    "mkdocs-git-revision-date-localized-plugin>=1.5.0",
    "mkdocs-literate-nav>=0.6.1",
    "mkdocs-material>=9.7.0",
    "mkdocs-minify-plugin>=0.8.0",
    "pymdown-extensions>=10.12",
    "mkdocs-jupyter>=0.24.8",
    "mkdocs>=1.6.1",
    "mkdocstrings[python]>=1.0.0",
    "mkdocs-table-reader-plugin>=3.1.0",
    "mkdocs-charts-plugin>=0.0.13",
]
