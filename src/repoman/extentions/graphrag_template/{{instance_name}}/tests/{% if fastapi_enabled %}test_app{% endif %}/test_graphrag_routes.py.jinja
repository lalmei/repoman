{% if fastapi_enabled %}"""GraphRAG route smoke tests."""

from fastapi import FastAPI
from fastapi.testclient import TestClient

from {{python_package_import_name}}.app.router import root_api_router
from {{python_package_import_name}}.config import Config


def test_graphrag_status_route() -> None:
    app = FastAPI()
    app.include_router(root_api_router)
    client = TestClient(app)

    prefix = Config().fastapi_config.api_prefix
    response = client.get(f"{prefix}/graphrag/status")
    assert response.status_code == 200
    assert response.json()["status"] == "ok"
{% endif %}
