"""Tests for GraphRAG CLI command scaffold."""

from typer.testing import CliRunner

from {{python_package_import_name}}.cli.commands.graphrag import app


def test_graphrag_help() -> None:
    runner = CliRunner()
    result = runner.invoke(app, ["--help"])
    assert result.exit_code == 0
    assert "status" in result.output


def test_graphrag_status() -> None:
    runner = CliRunner()
    result = runner.invoke(app, ["status"])
    assert result.exit_code == 0
    assert "graphrag: ok" in result.output
