"""Tests for the {{command_name}} command."""

from __future__ import annotations

from unittest.mock import patch

import pytest
from typer.testing import CliRunner

from {{python_package_import_name}}.cli.commands.{{command_name}} import app


@pytest.fixture
def runner() -> CliRunner:
    """Provide a CLI runner for testing the {{command_name}} command."""
    return CliRunner()


def test_{{command_name}}_help(runner: CliRunner) -> None:
    """Test {{command_name}} command help."""
    result = runner.invoke(app, ["--help"])
    assert result.exit_code == 0
    assert "Usage:" in result.output
    assert "{{command_name}}" in result.output.lower()
    assert "{{command_description}}" in result.output.lower()


def test_{{command_name}}_basic_invocation(runner: CliRunner) -> None:
    """Test basic {{command_name}} command invocation."""
    with patch("{{python_package_import_name}}.cli.commands.{{command_name}}.get_logger_console"):
        result = runner.invoke(app, [])
        assert result.exit_code in (0, 2)


def test_{{command_name}}_with_project_id(runner: CliRunner) -> None:
    """Test {{command_name}} command with project_id option."""
    with patch("{{python_package_import_name}}.cli.commands.{{command_name}}.get_logger_console"):
        result = runner.invoke(app, ["--project_id", "test-project-123"])
        assert result.exit_code in (0, 2)


def test_{{command_name}}_with_short_project_id_flag(runner: CliRunner) -> None:
    """Test {{command_name}} command with short project_id flag."""
    with patch("{{python_package_import_name}}.cli.commands.{{command_name}}.get_logger_console"):
        result = runner.invoke(app, ["-p", "test-project-456"])
        assert result.exit_code in (0, 2)


def test_{{command_name}}_command_registered(cli_runner, cli_app) -> None:
    """Test that {{command_name}} command is registered in the main CLI."""
    result = cli_runner.invoke(cli_app, ["{{command_name}}", "--help"])
    assert result.exit_code == 0
    assert "{{command_name}}" in result.output.lower()
    assert "Usage:" in result.output or "{{command_description}}" in result.output.lower()
