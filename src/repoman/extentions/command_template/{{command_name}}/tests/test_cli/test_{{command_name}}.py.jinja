"""Test the generated command through the root CLI."""

from typer.testing import CliRunner

from {{ python_package_import_name }}.cli import cli


def test_starter_runs() -> None:
    """Run the command without options."""
    result = CliRunner().invoke(cli, ["{{ command_name }}"])

    assert result.exit_code == 0, result.output
    assert result.output.splitlines() == ["Running {{ command_name }}."]


def test_starter_accepts_project_id() -> None:
    """Pass a project ID through the root CLI."""
    result = CliRunner().invoke(cli, ["{{ command_name }}", "--project-id", "example-project"])

    assert result.exit_code == 0, result.output
    assert result.output.splitlines() == [
        "Running {{ command_name }}.",
        "Project ID: example-project",
    ]
