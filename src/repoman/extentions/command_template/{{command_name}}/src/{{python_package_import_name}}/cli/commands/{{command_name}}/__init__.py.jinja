"""Starter Typer command."""

from typing import Annotated

from typer import Option, Typer, echo

app = Typer(invoke_without_command=True)


@app.callback(help={{ command_description | pprint }})
def run(
    project_id: Annotated[
        str | None,
        Option("--project-id", "-p", "--project_id", help="Project ID to display."),
    ] = None,
) -> None:
    """Run the starter command."""
    echo("Running {{ command_name }}.")
    if project_id is not None:
        echo(f"Project ID: {project_id}")
