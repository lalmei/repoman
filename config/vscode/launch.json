{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Repoman CLI",
      "type": "debugpy",
      "request": "launch",
      "module": "repoman",
      "args": ["--help"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-c", "config/pytest.ini", "${file}", "-vvv"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    }
  ]
}
